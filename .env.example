# Copy to .env.local for local dev. Never commit real values.
# For a deployment (Vercel/Netlify), set these in the dashboard's
# Environment Variables and REDEPLOY — changing them alone does not
# update an already-built deployment.

# REQUIRED for all AI features (analyze, interview, job-scan, outreach, ...).
# Get it at console.anthropic.com — it starts with sk-ant-.
# Paste it with no surrounding quotes and no trailing spaces.
ANTHROPIC_API_KEY=

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Optional / feature services
JINA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RESEND_API_KEY=
EMAIL_FROM=

# Security (set in production — see PR #2 notes)
CRON_SECRET=
EXTENSION_TOKEN_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=
